{
  "name": "llm-browser",
  "version": "1.0.0",
  "description": "Semantic browser runtime for LLM agents",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./sdk": "./dist/sdk/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "measure:snapshot": "ts-node scripts/measure_snapshot.ts",
    "py:test": "python -m unittest discover -s python/tests",
    "sdk:smoke": "ts-node scripts/sdk_smoke.ts",
    "smoke:api": "ts-node scripts/api_smoke.ts",
    "test": "jest",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.8.0",
    "@types/pino": "^7.0.4",
    "@types/ws": "^8.18.1",
    "express": "^5.2.1",
    "jest": "^30.4.2",
    "pino": "^10.3.1",
    "playwright": "^1.60.0",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "ws": "^8.20.1"
  }
}
